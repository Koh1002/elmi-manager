# ==================================================
# elmi-manager バックエンド 環境変数テンプレート
# コピーして .env に名前変更し、値を設定してください。
# ==================================================

ENVIRONMENT=local  # local | staging | production

# AWS 共通
AWS_REGION=ap-northeast-1

# DynamoDB
DYNAMODB_TABLE_PREFIX=elmi-manager-shinoda
# DYNAMODB_ENDPOINT=http://localhost:4566  # LocalStack 使用時

# S3（設定ファイル管理用）
S3_CONFIG_BUCKET=elmi-manager-shinoda-config-XXXXXXXXXXXX
# S3_ENDPOINT=http://localhost:4566  # LocalStack 使用時

# Cognito（管理対象: エルみえるの User Pool）
COGNITO_TARGET_POOL_ID=ap-northeast-1_XXXXXXXXX

# Cognito（elmi-manager 自身の管理者認証用）
COGNITO_MANAGER_POOL_ID=ap-northeast-1_YYYYYYYYY
COGNITO_MANAGER_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Bedrock（AI 分析用）
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# SES（メール送信用）
SES_SENDER_EMAIL=noreply@yourdomain.com

# エルみえる API（テスト実行用）
ELMI_API_ENDPOINT=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/prod

# 日次レポート内部認証
INTERNAL_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
